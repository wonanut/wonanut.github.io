{
  "name": "@wonanut/dsh-agent-lab",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Agent 实验室：在模拟 TUI 中体验迷你 Agent 的输入、上下文、LLM、工具、记忆与压缩，并查看实现源码与原理。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "src/*.js",
    "build.mjs",
    "README.md",
    "LICENSE",
    "CONTRACT.md",
    "test/*.mjs",
    "preview/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "immediately": true
    }
  },
  "license": "MIT",
  "author": "wonanut",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent",
    "agent-lab",
    "learning",
    "tui",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonanut/dsh-plugins.git",
    "directory": "agent-lab-plugin"
  },
  "homepage": "https://github.com/wonanut/dsh-plugins/tree/main/agent-lab-plugin",
  "bugs": {
    "url": "https://github.com/wonanut/dsh-plugins/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
